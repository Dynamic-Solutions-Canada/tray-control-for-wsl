<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <!-- The Store identity reserved in Partner Center (Store ID 9MTQWTX87B8J). Permanent: never change
       it. Signed dev builds are stamped with the dev identity (dev_identity in windows-build.json) and
       the signing cert's publisher by the kit's build-msix.ps1; Store uploads (-NoSign) keep these values. -->
  <Identity
    Name="DynamicSolutionsCA.WSLMonitor"
    Publisher="CN=C21E6CEF-D0D1-4497-93F9-3718D054DA0E"
    Version="VERSION_PLACEHOLDER"
    ProcessorArchitecture="ARCH_PLACEHOLDER" />

  <Properties>
    <DisplayName>WSL Monitor</DisplayName>
    <PublisherDisplayName>Dynamic Solutions (CA)</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <!-- Keep in step with Microsoft.WindowsAppSDK in WslMonitor.csproj (1.8 line). -->
    <PackageDependency Name="Microsoft.WindowsAppRuntime.1.8" MinVersion="8000.770.947.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <!-- Interface languages: keep in step with WslMonitor/Classes/AppLanguages.cs and Localization/Catalogs/*.json
       (npm run check:l10n). ms-resource:Resources/<Key> strings come from those catalogs; the
       MSIX script indexes them into resources.pri. -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="en-CA" />
    <Resource Language="es-ES" />
    <Resource Language="fr-FR" />
    <Resource Language="fr-CA" />
    <Resource Language="de-DE" />
    <Resource Language="zh-CN" />
    <Resource Language="pt-BR" />
    <Resource Language="ja-JP" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="WslMonitor.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="WSL Monitor"
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png"
        Description="ms-resource:Resources/AppDescription">
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- desktop: (not uap:) namespace - makeappx rejects uap: startup tasks for full-trust apps. -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="WslMonitorStartup" Enabled="true" DisplayName="WSL Monitor" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
