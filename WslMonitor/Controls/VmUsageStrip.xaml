<UserControl
    x:Class="WslMonitor.Controls.VmUsageStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization">
    <!-- Two cards side by side: CPU (figure and a one-minute sparkline) and memory (figure, a meter
         against the VM's limit, and the limit). Both graphics are 28 px tall so the cards match.
         Brushes are theme resources, so a theme change restyles them without a rebuild. A Border has
         no automation peer, so screen readers reach the label and figure text blocks; the figures
         carry the tooltip's explanation as help text. -->
    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- CPU -->
        <Border x:Name="CpuCard" Style="{StaticResource CardBorderStyle}" Padding="12,8,12,10">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>
                <!-- A long label (German "Arbeitsspeicher") trims rather than running under the figure. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock l10n:Localize.Text="usage.cpu" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CpuValue" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}"
                               AutomationProperties.AutomationId="VmCpuValue" />
                </Grid>

                <!-- Sparkline: fixed 0 to 100% scale, newest reading at the right edge; drawn in code. -->
                <Grid x:Name="CpuChart" Grid.Row="1" SizeChanged="CpuChart_SizeChanged">
                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Polygon x:Name="CpuArea" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.18" />
                    <Polyline x:Name="CpuLine" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
            </Grid>
        </Border>

        <!-- Memory -->
        <Border x:Name="MemoryCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12,8,12,10">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>
                <!-- A long label (German "Arbeitsspeicher") trims rather than running under the figure. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock l10n:Localize.Text="usage.memory" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="MemoryValue" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}"
                               AutomationProperties.AutomationId="VmMemoryValue" />
                </Grid>

                <StackPanel Grid.Row="1" Spacing="6" VerticalAlignment="Bottom">
                    <!-- Meter: the track is a lighter step of the fill's own colour; the two columns'
                         star widths are the used and free shares, so no measuring is needed. -->
                    <Grid Height="6" CornerRadius="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="MemoryUsedColumn" Width="0*" />
                            <ColumnDefinition x:Name="MemoryFreeColumn" Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.ColumnSpan="2" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.2" />
                        <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="3" RadiusY="3" />
                    </Grid>
                    <TextBlock x:Name="MemoryLimit" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
