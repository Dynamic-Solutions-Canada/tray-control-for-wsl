<Page
    x:Class="WslMonitor.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization"
    xmlns:kitc="using:WinUIAppKit.Controls">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock l10n:Localize.Text="nav.settings" Style="{StaticResource PageTitleStyle}" />

            <!-- The kit's "settings were reset" notice goes here, after an unreadable settings file (CONF-2) -->
            <ContentPresenter x:Name="NoticeHost" />

            <TextBlock l10n:Localize.Text="settings.behaviour" Style="{StaticResource FirstSectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <kitc:StartupSetting x:Name="StartupRow" />
                    <ToggleSwitch x:Name="SystemDistrosSwitch" l10n:Localize.Header="settings.system-distros"
                                  l10n:Localize.OnContent="kit.settings.on" l10n:Localize.OffContent="kit.settings.off"
                                  Toggled="SystemDistrosSwitch_Toggled" />
                </StackPanel>
            </Border>

            <TextBlock l10n:Localize.Text="settings.appearance" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <kitc:LanguageSetting x:Name="LanguageRow" />
                    <kitc:ThemeSetting x:Name="ThemeRow" />
                </StackPanel>
            </Border>

            <TextBlock l10n:Localize.Text="settings.reset" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock l10n:Localize.Text="settings.reset-desc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Click="ResetSettings_Click" HorizontalAlignment="Left">
                        <StackPanel Style="{StaticResource IconLabelStyle}">
                            <FontIcon Glyph="&#xE777;" Style="{StaticResource ButtonGlyphStyle}" />
                            <TextBlock l10n:Localize.Text="settings.reset-button" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
