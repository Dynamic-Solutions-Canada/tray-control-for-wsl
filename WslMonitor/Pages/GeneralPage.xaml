<Page
    x:Class="WslMonitor.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization">
    <ScrollViewer>
        <StackPanel Padding="36,12,36,36" Spacing="8" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock l10n:Localize.Text="nav.settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <TextBlock l10n:Localize.Text="settings.behaviour" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,0,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="StartupSwitch" l10n:Localize.Header="settings.startup"
                                  l10n:Localize.OnContent="toggle.on" l10n:Localize.OffContent="toggle.off"
                                  Toggled="StartupSwitch_Toggled" />
                    <ToggleSwitch x:Name="SystemDistrosSwitch" l10n:Localize.Header="settings.system-distros"
                                  l10n:Localize.OnContent="toggle.on" l10n:Localize.OffContent="toggle.off"
                                  Toggled="SystemDistrosSwitch_Toggled" />
                </StackPanel>
            </Border>

            <TextBlock l10n:Localize.Text="settings.appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <ComboBox x:Name="LanguageCombo" l10n:Localize.Header="settings.language" MinWidth="220"
                              SelectionChanged="LanguageCombo_SelectionChanged" />
                    <ComboBox x:Name="ThemeCombo" l10n:Localize.Header="settings.theme" MinWidth="220"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem l10n:Localize.Content="settings.use-system" />
                        <ComboBoxItem l10n:Localize.Content="settings.theme-light" />
                        <ComboBoxItem l10n:Localize.Content="settings.theme-dark" />
                    </ComboBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
