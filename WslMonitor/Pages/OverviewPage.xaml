<pages:LivePage
    x:Class="WslMonitor.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization"
    xmlns:pages="using:WslMonitor.Pages">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock l10n:Localize.Text="nav.overview" Style="{StaticResource PageTitleStyle}" />

            <TextBlock l10n:Localize.Text="nav.distros" Style="{StaticResource FirstSectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="6,6,6,6">
                <StackPanel x:Name="DistroRows" Spacing="2" />
            </Border>

            <TextBlock Text="WSL" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="StartBehaviourText" TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock l10n:Localize.Text="overview.shutdown" />
                        <TextBlock x:Name="ShutdownText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="ShutdownButton" Grid.Column="1" VerticalAlignment="Center" Click="Shutdown_Click">
                        <StackPanel Style="{StaticResource IconLabelStyle}">
                            <FontIcon Glyph="&#xE7E8;" Style="{StaticResource ButtonGlyphStyle}" />
                            <TextBlock l10n:Localize.Text="overview.shutdown" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</pages:LivePage>
