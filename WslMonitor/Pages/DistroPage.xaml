<Page
    x:Class="WslMonitor.Pages.DistroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization">
    <ScrollViewer>
        <StackPanel Padding="36,12,36,36" Spacing="8" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <TextBlock l10n:Localize.Text="distro.status" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,0,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="BadgeHost" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StateText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StopBehaviourText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    </StackPanel>
                    <ContentPresenter x:Name="PowerHost" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock l10n:Localize.Text="distro.open" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="Terminal_Click" l10n:Localize.ToolTip="distro.terminal-tip">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE756;" FontSize="14" />
                            <TextBlock l10n:Localize.Text="distro.terminal" />
                        </StackPanel>
                    </Button>
                    <Button Click="Files_Click" l10n:Localize.ToolTip="distro.files-tip">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                            <TextBlock l10n:Localize.Text="distro.files" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DefaultButton" Click="Default_Click" l10n:Localize.ToolTip="distro.make-default-tip">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE734;" FontSize="14" />
                            <TextBlock l10n:Localize.Text="distro.make-default" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock l10n:Localize.Text="distro.details" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid x:Name="DetailsGrid" ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
