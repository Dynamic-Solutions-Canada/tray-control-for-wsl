<Page
    x:Class="WslMonitor.Pages.DistroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="36,12,36,36" Spacing="8" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <TextBlock Text="Status" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,0,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="BadgeHost" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StateText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StopBehaviourText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    </StackPanel>
                    <ContentPresenter x:Name="PowerHost" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="Open" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="Terminal_Click" ToolTipService.ToolTip="Open a shell in your home folder (starts the distro if it's stopped)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE756;" FontSize="14" />
                            <TextBlock Text="Terminal" />
                        </StackPanel>
                    </Button>
                    <Button Click="Files_Click" ToolTipService.ToolTip="Browse the distro's files in Explorer (starts the distro if it's stopped)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                            <TextBlock Text="Files" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DefaultButton" Click="Default_Click" ToolTipService.ToolTip="Make this the distro that plain wsl opens">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE734;" FontSize="14" />
                            <TextBlock Text="Make default" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Text="Details" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid x:Name="DetailsGrid" ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
