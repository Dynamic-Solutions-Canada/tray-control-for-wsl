<pages:LivePage
    x:Class="WslMonitor.Pages.DistroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization"
    xmlns:pages="using:WslMonitor.Pages">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />

            <TextBlock l10n:Localize.Text="distro.status" Style="{StaticResource FirstSectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="BadgeHost" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StateText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StopBehaviourText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    </StackPanel>
                    <ContentPresenter x:Name="PowerHost" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock l10n:Localize.Text="distro.open" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="Terminal_Click" l10n:Localize.ToolTip="distro.terminal-tip">
                        <StackPanel Style="{StaticResource IconLabelStyle}">
                            <FontIcon Glyph="&#xE756;" Style="{StaticResource ButtonGlyphStyle}" />
                            <TextBlock l10n:Localize.Text="distro.terminal" />
                        </StackPanel>
                    </Button>
                    <Button Click="Files_Click" l10n:Localize.ToolTip="distro.files-tip">
                        <StackPanel Style="{StaticResource IconLabelStyle}">
                            <FontIcon Glyph="&#xE838;" Style="{StaticResource ButtonGlyphStyle}" />
                            <TextBlock l10n:Localize.Text="distro.files" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DefaultButton" Click="Default_Click" l10n:Localize.ToolTip="distro.make-default-tip">
                        <StackPanel Style="{StaticResource IconLabelStyle}">
                            <FontIcon Glyph="&#xE734;" Style="{StaticResource ButtonGlyphStyle}" />
                            <TextBlock l10n:Localize.Text="distro.make-default" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock l10n:Localize.Text="distro.details" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid x:Name="DetailsGrid" ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</pages:LivePage>
